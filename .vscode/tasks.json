{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run",
            "type": "shell",
            "command": "javac ${file} && java ${fileBasenameNoExtension} < input.txt > output.txt",
            "windows": {
                "command": "cmd",
                "args": [
                    "/C",
                    "javac ${file} && java ${fileBasenameNoExtension} < input.txt > output.txt"
                ]
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
